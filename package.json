{
  "name": "pranay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "python3 scripts/generate_resume_pdf.py",
    "build": "next build",
    "resume:build": "python3 scripts/generate_resume_pdf.py",
    "portfolio:validate": "node scripts/verify_portfolio_source.mjs && node scripts/verify_visual_evidence.mjs",
    "book:build": "python3 book/tools/assemble_manuscript.py && python3 book/tools/build_html.py && python3 book/tools/build_epub.py && python3 book/tools/build_pdf.py && python3 book/tools/build_sales_page.py && python3 book/tools/embed_html_assets.py && python3 book/tools/write_package_manifest.py",
    "book:validate": "python3 book/tools/check_cleanup_protection.py && python3 book/tools/check_manuscript.py && python3 book/tools/check_package.py",
    "book:audio:build": "python3 book/tools/build_audio_narration.py",
    "book:audio:plan": "python3 book/tools/generate_audiobook.py plan",
    "book:audio:generate": "python3 book/tools/generate_audiobook.py generate",
    "book:audio:master": "python3 book/tools/master_audiobook.py",
    "book:audio:validate": "python3 book/tools/check_audiobook.py",
    "clean:safe": "python3 book/tools/cleanup_generated.py",
    "clean:safe:apply": "python3 book/tools/cleanup_generated.py --apply",
    "deploy:cloudflare": "npm run build && wrangler pages deploy out --project-name pranay --branch main",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.7.4",
    "lucide-react": "^0.503.0",
    "next": "15.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.0",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
